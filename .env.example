# 로컬에서 Doppler 없이 쓸 때만 참고 (선택).
# 기본 워크플로: Doppler에만 값을 두고 `pnpm dev` 등으로 주입합니다.
#
# Vite 클라이언트에 노출하려면 반드시 VITE_ 접두사 사용.

# VITE_API_BASE_URL=https://api.example.com
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 결제 테스트 상품(2명/10원 QA용, 콘솔 440원) 노출 여부. QA/스테이징 빌드에만 true로 설정하고
# 프로덕션(main 배포)에는 설정하지 않는다.
# VITE_ENABLE_PAYMENT_TEST_OPTIONS=true
